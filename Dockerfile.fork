# Thin overlay image: the published release plus THIS fork's pipeline scripts.
#
# Dockerfile.builder is the standalone build (it also bakes a Whisper model). This overlay
# exists so a fork can be exercised on a host that already has the release image — no model
# download, no UI rebuild — when the fork only changes the flat pipeline scripts.
#
#   docker build -f Dockerfile.fork -t dubtitlerr:fork .
#
# Deliberately pinned to the last UPSTREAM release: this overlay exercises the fork's
# scripts on the upstream runtime, not on the fork's own image. Bump it only when upstream
# publishes a new release.
FROM ghcr.io/xenarathon/dubtitlerr:v0.3.0

# The fork runtime now lives in the dubtitlerr package; the overlay carries the package,
# the fork shells, and the same data/shell/tools the standalone images ship.
COPY dubtitlerr/ /app/dubtitlerr/
COPY gen_loop.sh container_run.sh merge_pass.sh /app/
COPY data/ /app/data/
COPY shell/ /app/shell/
COPY tools/ /app/tools/
ENV PYTHONPATH=/app
